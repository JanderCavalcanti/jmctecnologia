rules_version = '2';

// Regras do Cloud Firestore para o mini CRM da Área do cliente.
// Colar em: Console do Firebase > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() {
      return request.auth.token.email.lower();
    }
    function admin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(meuEmail()));
    }

    // Lista de administradores: o ID de cada documento é o e-mail (minúsculo).
    // Cada pessoa só consegue consultar o próprio e-mail; ninguém altera pelo site.
    match /admins/{email} {
      allow read: if logado() && email == meuEmail();
      allow write: if false;
    }

    // Cadastro do cliente (preenchido no primeiro acesso): cada um lê e edita só o próprio.
    match /clientes/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow create, update: if admin() || (logado() && request.auth.uid == uid
        && request.resource.data.email == meuEmail()
        && request.resource.data.documento is string
        && request.resource.data.documento.size() in [11, 14]);
      allow delete: if admin();
    }

    // Propostas: o cliente lê só as do próprio e-mail; só administradores gravam.
    match /propostas/{id} {
      allow read: if admin() || (logado() && resource.data.clienteEmail == meuEmail());
      allow create, update: if admin()
        && request.resource.data.clienteEmail is string
        && request.resource.data.etapa in [0, 1, 2];
      allow delete: if admin();
    }
  }
}
