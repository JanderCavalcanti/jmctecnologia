# Modelo do .env do serviço Supabase no Easypanel. Os valores reais ficam só no Easypanel.
# Gere segredos novos (ex.: openssl rand -hex 32); ANON_KEY e SERVICE_ROLE_KEY são JWTs HS256
# assinados com JWT_SECRET (role "anon" / "service_role", iss "supabase").
SUPABASE_PUBLIC_URL=https://supabase.jmctecnologia.com.br
SITE_URL=https://www.jmctecnologia.com.br/area-do-cliente.html
ADDITIONAL_REDIRECT_URLS=https://www.jmctecnologia.com.br/area-do-cliente.html,https://www.jmctecnologia.com.br/teste/area-do-cliente.html
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
PG_META_CRYPTO_KEY=
# Usuário e senha do painel (Studio): linha "usuario:hash-apr1" do htpasswd, em base64.
DASHBOARD_HTPASSWD_B64=
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
